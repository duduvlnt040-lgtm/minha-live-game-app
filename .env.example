# ==============================================================================
# MINHA LIVE GAMES — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha apenas as credenciais necessárias.
# ==============================================================================

# URL pública da aplicação (usada para links de overlay e callbacks)
APP_URL="http://localhost:3000"

# Porta do servidor HTTP + WebSocket (obrigatório 3000 em desenvolvimento)
PORT=3000

# E-mail do administrador principal (recebe role=admin automaticamente no servidor)
ADMIN_EMAIL="duduvlnt040@gmail.com"

# Segredo para assinatura de sessões (gere uma string aleatória segura em produção)
SESSION_SECRET="troque-esta-chave-em-producao"

# ==============================================================================
# FIREBASE (Opcional / Etapa de Produção na Vercel)
# Caso deseje conectar o Firebase Auth e Cloud Firestore no seu projeto:
# 1. Crie um projeto no Firebase Console (plano gratuito Spark).
# 2. Ative Authentication (E-mail/Senha) e Cloud Firestore.
# 3. Cole as credenciais do app Web abaixo.
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ==============================================================================
# INTEGRAÇÕES EXTERNAS (Etapa Futura / Opcionais)
# ==============================================================================
# Provedor TikTok LIVE (ex.: relay externo ou websocket bridge)
TIKTOK_CONNECTOR_MODE="standalone"

# Mercado Pago (preparado para etapa futura de cobrança — não habilitar sem autorização)
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
