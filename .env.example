# ==============================================================================
# MINHA LIVE GAMES — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env em desenvolvimento ou configure na Vercel
# (Project Settings -> Environment Variables).
# ==============================================================================

# URL pública da aplicação (ex.: https://minha-live-game-app.vercel.app)
APP_URL="http://localhost:3000"

# Porta do servidor local HTTP + WebSocket (obrigatório 3000 em desenvolvimento)
PORT=3000

# E-mail do administrador principal (recebe role=admin automaticamente no servidor)
ADMIN_EMAIL="duduvlnt040@gmail.com"

# Segredo para assinatura HMAC das sessões de autenticação (defina uma chave aleatória na Vercel)
SESSION_SECRET=""

# ==============================================================================
# PERSISTÊNCIA NA VERCEL (Recomendado para produção serverless — plano gratuito)
# Conecte um banco Upstash Redis / Vercel KV no painel Storage da Vercel para
# preencher automaticamente as variáveis abaixo:
# ==============================================================================
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ==============================================================================
# ENVIO DE E-MAIL DE RECUPERAÇÃO DE SENHA (Opcional — Resend)
# ==============================================================================
RESEND_API_KEY=""
EMAIL_FROM="MINHA LIVE GAMES <onboarding@resend.dev>"

# ==============================================================================
# FIREBASE (Opcional)
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ==============================================================================
# INTEGRAÇÕES EXTERNAS (Etapa Futura / Opcionais)
# ==============================================================================
TIKTOK_CONNECTOR_MODE="standalone"
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
