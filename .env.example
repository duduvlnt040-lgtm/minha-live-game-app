# ==============================================================================
# MINHA LIVE GAMES — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env em desenvolvimento ou configure na Vercel
# (Project Settings -> Environment Variables).
# ==============================================================================

# URL pública da aplicação (ex.: https://minha-live-game-app.vercel.app)
APP_URL="http://localhost:3000"

# Porta do servidor local HTTP + WebSocket (obrigatório 3000 em desenvolvimento)
PORT=3000

# E-mail do administrador principal (recebe role=admin automaticamente no servidor)
ADMIN_EMAIL="duduvlnt040@gmail.com"

# Segredo opcional para assinaturas auxiliares no servidor
SESSION_SECRET=""

# ==============================================================================
# SUPABASE (Banco PostgreSQL + Authentication — Obrigatório)
# Encontre em: Supabase Dashboard -> Project Settings -> API Keys
# Aceita tanto as novas chaves (sb_publishable_... / sb_secret_...) quanto JWT legado
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NUNCA exponha a chave abaixo no frontend (somente servidor / Vercel Environment Variables):
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# UPSTASH VECTOR (Busca semântica / embeddings)
# ==============================================================================
UPSTASH_VECTOR_REST_URL=""
UPSTASH_VECTOR_REST_TOKEN=""

# ==============================================================================
# ENVIO DE E-MAIL DE RECUPERAÇÃO DE SENHA (Opcional — Resend)
# ==============================================================================
RESEND_API_KEY=""
EMAIL_FROM="MINHA LIVE GAMES <onboarding@resend.dev>"

# ==============================================================================
# FIREBASE (Opcional)
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ==============================================================================
# INTEGRAÇÕES EXTERNAS (Etapa Futura / Opcionais)
# ==============================================================================
TIKTOK_CONNECTOR_MODE="standalone"
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""

# Chave opcional de servidor para curadoria avançada da Rádio IA (gemini-4-hydrogen)
GEMINI_API_KEY=""
